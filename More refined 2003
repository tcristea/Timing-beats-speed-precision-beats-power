def generate_synthetic_garch(returns: pd.Series, n_sim: int = 1000, n_days: int = 252) -> List[pd.Series]:
    """Fit GARCH(1,1) to historical returns and simulate multiple paths."""
    if not ARCH_AVAILABLE:
